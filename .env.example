# Copy this file to .env and adjust as needed. .env itself is gitignored —
# it's local config, not something to commit. See REQUIREMENTS.md for context.

# Port the Express server (server/index.js) listens on when run directly
# (`node server/index.js` / `npm run serve`). When run via PM2
# (ecosystem.config.js), PM2's own PORT setting wins instead — keep the two
# in sync if you change one.
PORT=8002

# The Google Sheet ID for Mastex's "Price List with SOH_U" workbook, used by
# sync/sync-catalog.js to build the .xlsx export URL. Only change this if
# Mastex ever moves the catalog to a different sheet.
SHEET_ID=

# Base URL of the Luxtronic-Odoo-API service (github.com/.../Luxtronic-Odoo-API),
# used to show your own on-hand Odoo stock on each Mastex product (matched by
# EAN/barcode) so you don't have to check both systems separately. That service
# runs on the shop's LAN server alongside this app — reachable at this address
# from both the LAN server itself and any machine on the same LAN (e.g. a dev
# checkout). No auth (trusted-LAN only, per that project's own README). Leave
# blank to disable the feature entirely — products just won't show an Odoo
# stock badge, nothing else breaks.
ODOO_API_URL=http://192.168.68.255:4001
