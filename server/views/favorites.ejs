<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>All Favourites — Mastex Catalog</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link rel="stylesheet" href="/css/site.css">
<script src="/js/theme.js"></script>
</head>
<body>

<%- include("partials/header", {mark:"★", title:"All Favourites", tagline:"Across every vendor", search:"Search favourites by name, SKU, code or vendor…", kbd:true}) %>

<div class="banner">
  <div class="banner-inner">
    <span>★</span>
    <span>Everything you've favorited, from any vendor page, in one place. Click the star again to remove it.</span>
  </div>
</div>
<% if (inventoryStatus && inventoryStatus.enabled && (inventoryStatus.error || !inventoryStatus.updatedAt)) { %>
<div class="banner">
  <div class="banner-inner" style="background:var(--warn-bg); border-color:color-mix(in srgb, var(--warn) 35%, var(--border));">
    <span>🏬</span>
    <span>
      <% if (!inventoryStatus.updatedAt) { %>Odoo stock badges aren't showing yet — still waiting on the first successful fetch from the Odoo API.<% } else { %>Odoo stock badges may be stale — the last refresh failed (<%= inventoryStatus.error %>). Showing the last known values.<% } %>
    </span>
  </div>
</div>
<% } %>

<div class="filterbar">
  <div class="filter-controls">
    <label class="stock-toggle">
      <input type="checkbox" id="inStockOnly">
      <span class="switch"></span>
      In stock only
    </label>
    <select id="sortSelect">
      <option value="relevance">Sort: Relevance</option>
      <option value="vendor">Vendor A–Z</option>
      <option value="name-asc">Name A–Z</option>
      <option value="price-asc">Price: Low to High</option>
      <option value="price-desc">Price: High to Low</option>
      <option value="stock-desc">Stock: High to Low</option>
    </select>
    <div class="view-toggle">
      <button id="viewGrid" class="active" title="Grid view">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
      </button>
      <button id="viewList" title="List view">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
      </button>
    </div>
  </div>
</div>

<div class="meta-row">
  <span id="resultCount">Showing 0 favorites</span>
  <span></span>
</div>

<div class="catalog">
  <div class="grid" id="grid"></div>
  <div class="empty-state" id="emptyState" style="display:none;">
    <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
    <h3 id="emptyStateTitle">No favorites yet</h3>
    <p id="emptyStateBody">Click the star on any product across any vendor page to save it here.</p>
    <button id="emptyStateAction" onclick="location.href='/'">Browse vendors</button>
  </div>
</div>

<footer>
  <span id="footerSummary"><%= items.length %> favorite<%= items.length === 1 ? "" : "s" %> across <%= new Set(items.map(i => i.vendorSlug)).size %> vendor<%= new Set(items.map(i => i.vendorSlug)).size === 1 ? "" : "s" %></span>
  <span><a href="/">Back to all vendors</a></span>
</footer>

<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <div class="modal-top"><button class="modal-close" id="modalClose">✕</button></div>
    <div class="modal-content" id="modalContent"></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script src="/js/cart.js"></script>
<script src="/js/product-helpers.js"></script>
<script>
  window.__FAVORITE_ITEMS__ = <%- JSON.stringify(items) %>;
</script>
<script src="/js/favorites.js"></script>
</body>
</html>
